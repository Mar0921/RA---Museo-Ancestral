    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: idPin
      value: cazador
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioPin
      value: 
      objectReference: {fileID: 8300000, guid: bae06585bfc04454e9c8e30ca3350885, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: ordenPin
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: 004528940d0ebc64486c7d0046afd266, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoDelPin
      value: "Hace siglos, un Viernes Santo,\r\n\r\nun hombre dej\xF3 el serm\xF3n para perseguir a un\r\nvenado manso que pastaba cerca de la capilla.\r\n\r\nDispar\xF3 y fall\xF3.\r\n\r\nLo sigui\xF3 monte adentro,\r\n\r\nsin saber que el Hojarasqu\xEDn invert\xEDa\r\nlas huellas para que se perdiera.\r\n\r\nCuando cay\xF3 la noche, ya\r\nno sab\xEDa d\xF3nde estaba.\r\n\r\nTermin\xF3 frente a una mujer de hojas\r\ny musgo, con el rostro oculto,\r\n\r\ny esa fue su sentencia: quedarse.\r\n\r\nDesde entonces, en las noches de luna se\r\noyen disparos sin que se vea a nadie.\r\n\r\nEs el Cazador, condenado a perseguir\r\nsiempre al mismo venado sin alcanzarlo.\r\n\r\nNo tiene territorio:\r\nsolo tiene su escopeta,\r\n\r\nsus perros fantasmales y las luces errantes\r\nde las almas que caz\xF3 sin necesidad.\r\n\r\nSu historia es una advertencia: el\r\nmonte tambi\xE9n cuenta lo que le quitas."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: tituloObjeto
      value: "Br\xFAjula In\xFAtil"
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: objetoDetalle
      value: 
      objectReference: {fileID: 919132149155446097, guid: 997269469dbfea04c9c40425e4b3c909, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta1
      value: 
      objectReference: {fileID: 8300000, guid: f85a64544b267254dafad8879236a29b, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta2
      value: 
      objectReference: {fileID: 8300000, guid: 03d3ec136021c6f48ab1108fc5bf0d44, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: introduccionPin
      value: 
      objectReference: {fileID: 8300000, guid: 676f99b6d2808dd498eab2c5366a1d9c, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoIntroduccion
      value: "\xBFFaltan cosas? Tranquilos, sigamos con m\xFAsica."
      objectReference: {fileID: 0}
