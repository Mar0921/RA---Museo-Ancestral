    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: idPin
      value: silbon
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioPin
      value: 
      objectReference: {fileID: 8300000, guid: a9ca8a93634d3fc45b5e6de6af13f5cd, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: ordenPin
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: a7c8dde280604c44fb36248a23005244, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoDelPin
      value: "En la llanura de Colombia y\r\nVenezuela, cuando cae la noche,\r\n\r\nse escucha un silbido largo y triste.\r\n\r\nSi lo oyes lejos, est\xE1 cerca.\r\n\r\nSi lo oyes cerca, est\xE1 lejos.\r\n\r\nEs el Silb\xF3n: un joven delgado\r\ny p\xE1lido, de sombrero grande,\r\n\r\nque carga al hombro un saco de huesos,\r\n\r\nque en varias versiones\r\nson los de su padre.\r\n\r\nDicen que su historia es la de una falta\r\ngrave que lo conden\xF3 a vagar para siempre.\r\n\r\nSu silbido no busca sangre:\r\nbusca que te confundas,\r\n\r\nque dudes de lo que oyes\r\ny de tu propio camino.\r\n\r\nLos llaneros aprendieron a leer ese\r\nsonido, a no correr y a mantener la calma.\r\n\r\nPorque el Silb\xF3n desorienta,\r\npero tambi\xE9n recuerda:\r\n\r\nrecuerda que las acciones dejan huella,\r\n\r\ny que una historia mal contada\r\ntambi\xE9n pesa como un saco de huesos."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: tituloObjeto
      value: Silbato Confuso
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: objetoDetalle
