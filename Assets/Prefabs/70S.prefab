    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: idPin
      value: sombreron
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioPin
      value: 
      objectReference: {fileID: 8300000, guid: 74c0c0ac7082907439c66eb8da5cf696, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: ordenPin
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: 004528940d0ebc64486c7d0046afd266, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoDelPin
      value: "Cuando cae la noche en los pueblos\r\nde Antioquia, Caldas, Boyac\xE1,\r\n\r\nlos Santanderes y Cundinamarca,\r\nhay quien siente que lo siguen.\r\n\r\nNo se oye nada, y de pronto aparece:\r\n\r\nuna silueta con un sombrero\r\ndesproporcionadamente grande, a pie o a caballo,\r\n\r\ndif\xEDcil de identificar.\r\n\r\nEs el Sombrer\xF3n.\r\n\r\nNo habla.\r\n\r\nNo corre.\r\n\r\nSolo aparece de repente y persigue a\r\nquien trasnocha, a quien se excede,\r\n\r\na quien anda solo por la calle a deshoras.\r\n\r\nLas versiones var\xEDan: en algunas es una\r\npresencia de juego, en otras de amenaza.\r\n\r\nLos abuelos lo contaban para cuidar:\r\n\r\nhay horas para andar y\r\nhoras para descansar,\r\n\r\ny no todo lo que te sigue en la\r\nnoche se deja mirar de frente.\r\n\r\nSi lo sientes, no corras.\r\n\r\nVuelve a casa por el camino que conoces."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: tituloObjeto
      value: Sombrero Vigia
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: objetoDetalle
      value: 
      objectReference: {fileID: 919132149155446097, guid: 35dd0dd9109a655459fbc466956c9434, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta1
      value: 
      objectReference: {fileID: 8300000, guid: f85a64544b267254dafad8879236a29b, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta2
      value: 
      objectReference: {fileID: 8300000, guid: 03d3ec136021c6f48ab1108fc5bf0d44, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: introduccionPin
      value: 
      objectReference: {fileID: 8300000, guid: c1b2cacf22c0b4e4cae711a67716e758, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoIntroduccion
      value: "\xBFFaltan cosas? Tranquilos, sigamos con m\xFAsica."
      objectReference: {fileID: 0}
