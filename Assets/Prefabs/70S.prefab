    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: idPin
      value: mohan
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioPin
      value: 
      objectReference: {fileID: 8300000, guid: 004528940d0ebc64486c7d0046afd266, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: ordenPin
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: 004528940d0ebc64486c7d0046afd266, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoDelPin
      value: "Antes de que llegaran los espa\xF1oles, entre\r\nlos pijaos, moh\xE1n no era un espanto:\r\n\r\nera un cargo.\r\n\r\nEl del sacerdote, el curandero,\r\nel que le\xEDa las se\xF1ales del agua.\r\n\r\nUna noche vio venir la Conquista y\r\nentendi\xF3 que no pod\xEDa detenerla.\r\n\r\nEntonces baj\xF3 a las cuevas del r\xEDo\r\ncon los tesoros que quer\xEDa cuidar,\r\n\r\ny all\xED se qued\xF3,\r\n\r\nhasta dejar de ser hombre para\r\nvolverse esp\xEDritu de r\xEDos y quebradas.\r\n\r\nHoy los pescadores lo conocen\r\nbien: juguet\xF3n, embaucador,\r\n\r\nde sonrisa p\xEDcara y sombrero de paja.\r\n\r\nPone trampas antes de ayudar.\r\n\r\nY les ense\xF1\xF3 a no pedirle al r\xEDo sin\r\ndar algo a cambio: un poco de tabaco,\r\n\r\naguardiente o sal.\r\n\r\nDicen que quien cruza su r\xEDo sin\r\ncantar, se queda a vivir en \xE9l.\r\n\r\nLos cronistas lo contaron cada vez\r\npeor, pero el Moh\xE1n sigue ah\xED,\r\n\r\nesperando que alguien recuerde\r\nsu verdadera historia."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: tituloObjeto
      value: "Anzuelo P\xEDcaro"
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: objetoDetalle
      value: 
      objectReference: {fileID: 7505299716509459982, guid: 100a2f2310ae10e47a5953a296ffbdd5, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta1
      value: 
      objectReference: {fileID: 8300000, guid: f85a64544b267254dafad8879236a29b, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta2
      value: 
      objectReference: {fileID: 8300000, guid: 03d3ec136021c6f48ab1108fc5bf0d44, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: introduccionPin
      value: 
      objectReference: {fileID: 8300000, guid: b92fe5ecb31b7594a908f04d907faf86, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoIntroduccion
      value: "El r\xEDo suena distinto aqu\xED. Dejemos una ofrenda antes de cruzar."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
