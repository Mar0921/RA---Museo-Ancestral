    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: idPin
      value: duende
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioPin
      value: 
      objectReference: {fileID: 8300000, guid: 3d8d7040d7ae7f642b8a0362a2b00055, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: ordenPin
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: 004528940d0ebc64486c7d0046afd266, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoDelPin
      value: "Si en la casa o en el monte empiezan a\r\nfaltar cosas, la linterna, las llaves,\r\n\r\nel machete, no siempre fue descuido.\r\n\r\nPuede que el Duende ande cerca.\r\n\r\nEs peque\xF1o, de sombrero\r\ngrande y sonrisa traviesa,\r\n\r\ny a veces lleva un tiple en la mano.\r\n\r\nCuando toca, su melod\xEDa\r\natrae o desorienta.\r\n\r\nLe encanta enga\xF1ar con verdades a medias,\r\n\r\nesconder lo que uno m\xE1s necesita\r\ny ver qu\xE9 hace el desprevenido.\r\n\r\nPero detr\xE1s de la risa\r\nhay una tristeza vieja,\r\n\r\nla de quien vive en un lugar\r\nque ya casi nadie respeta.\r\n\r\nEs el due\xF1o del claro, y quien ensucia\r\nsu casa tarde o temprano lo escucha.\r\n\r\nHabla, pregunta, se burla.\r\n\r\nY si aprendes a o\xEDrlo sin\r\nenojarte, termina siendo gu\xEDa:\r\n\r\nte lleva hasta donde alguien\r\nm\xE1s grande te est\xE1 esperando.\r\n\r\nCon el Duende, lo primero\r\nes no perder la calma."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: tituloObjeto
      value: "Llave Mel\xF3dica"
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: objetoDetalle
      value: 
      objectReference: {fileID: 5212916959866523616, guid: 642586ef018063f4b96ddb88c7b2c43a, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta1
      value: 
      objectReference: {fileID: 8300000, guid: f85a64544b267254dafad8879236a29b, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuesta2
      value: 
      objectReference: {fileID: 8300000, guid: 03d3ec136021c6f48ab1108fc5bf0d44, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: introduccionPin
      value: 
      objectReference: {fileID: 8300000, guid: 521062a1001434348940e0b98babefea, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoIntroduccion
      value: "\xBFFaltan cosas? Tranquilos, sigamos con m\xFAsica."
      objectReference: {fileID: 0}
