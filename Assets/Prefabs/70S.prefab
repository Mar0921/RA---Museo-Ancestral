    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: idPin
      value: muelona
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioPin
      value: 
      objectReference: {fileID: 8300000, guid: 167a61bb82e3f9047ae8ab3ba2730108, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: ordenPin
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioClip
      value: 
      objectReference: {fileID: 8300000, guid: a7c8dde280604c44fb36248a23005244, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: textoDelPin
      value: "En los caminos del Valle, del\r\nCauca, del Tolima y de Antioquia,\r\n\r\na las horas en que el aguardiente\r\npesa y el paso se vuelve torpe,\r\n\r\npuede aparecer una mujer\r\natractiva que sonr\xEDe desde lejos.\r\n\r\nEs la Muelona.\r\n\r\nSe muestra amable, casi irresistible,\r\n\r\nhasta que revela una dentadura\r\ndesproporcionada que nadie olvida.\r\n\r\nLos abuelos la contaban a los hombres\r\nque andaban borrachos o de mujeriegos,\r\n\r\ncomo advertencia: no andes\r\nde madrugada sin compa\xF1\xEDa,\r\n\r\nno sigas a quien no conoces, no conf\xEDes\r\nen la belleza que aparece de repente.\r\n\r\nSu lecci\xF3n no es solo el miedo.\r\n\r\nEs la advertencia de que los excesos tienen\r\nconsecuencias y de que hay caminos que piden respeto.\r\n\r\nQuien vuelve a casa a salvo\r\nes quien escuch\xF3 a tiempo."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: tituloObjeto
      value: "Espejo Enga\xF1oso"
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
