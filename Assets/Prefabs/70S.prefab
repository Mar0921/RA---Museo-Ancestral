      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuestaCorrecta
      value: 
      objectReference: {fileID: 8300000, guid: 0da02ad3d89d8b0459c334003983348c, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: 'objetosAR.Array.data[0]'
      value: 
      objectReference: {fileID: 6982953533367341445}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioRespuestaIncorrecta
      value: 
      objectReference: {fileID: 8300000, guid: bf4745f8df3cc3646ae51436869da661, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: audioIntroduccionSiguienteEtapa
      value: 
      objectReference: {fileID: 8300000, guid: 7ba43be256a550a4e8ca31848edb6ee4, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: preguntaInteractiva1.textoPregunta
      value: "\xBFC\xF3mo naci\xF3 la UAO?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: preguntaInteractiva2.textoPregunta
      value: "\xBFQui\xE9n lider\xF3 sus primeros pasos?"
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: preguntaInteractiva1.audioRespuesta
      value: 
      objectReference: {fileID: 8300000, guid: 3f913b58b094c224bb6de46e27fda7d5, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: preguntaInteractiva1.textoRespuesta
      value: " Naci\xF3 en 1969, cuando profesores y estudiantes crearon una nueva instituci\xF3n tras el cierre de la Universidad Tecnol\xF3gica del Valle."
      objectReference: {fileID: 0}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: preguntaInteractiva2.audioRespuesta
      value: 
      objectReference: {fileID: 8300000, guid: 6bc31103675dd694aa23060359e0b262, type: 3}
    - target: {fileID: 5595221159592902849, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: preguntaInteractiva2.textoRespuesta
      value: "May Ackerman, quien gui\xF3 el inicio de \u201Cla universidad de la segunda oportunidad"
      objectReference: {fileID: 0}
    - target: {fileID: 8948850001108320288, guid: 1c4da1def26f25e48985b1f9fe3737a8, type: 3}
      propertyPath: m_Resource
      value: 
      objectReference: {fileID: 8300000, guid: 61230d6053e36874db5637628ec00f1f, type: 3}
