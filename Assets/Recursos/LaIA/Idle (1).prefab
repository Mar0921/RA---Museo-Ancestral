  audioBienvenida: {fileID: 8300000, guid: 3f767533b7bff88479743a4bff1af762, type: 3}
  textoBienvenida: "Hola, soy tu Esp\xEDritu Gu\xEDa.\n\r\nTe acompa\xF1ar\xE9 en este recorrido por las historias y leyendas que viven en nuestros territorios.  Aqu\xED encontrar\xE1s relatos, personajes y lugares que guardan parte de nuestra memoria.\n\r\nEscucha con atenci\xF3n, observa lo que encuentres. Y recuerda: en este viaje, el respeto por el territorio es lo primero.\n\r\nCuando est\xE9s listo, comencemos."
  animatorController: {fileID: 9100000, guid: 8cf7efea61211a440b1dca64c2b95784, type: 2}
  animacionBienvenida: isWaving
  duracionAnimacionBienvenida: 2
